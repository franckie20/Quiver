{
  "name": "quiver-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "prestart": "npm run generate:api",
    "prebuild": "npm run generate:api",
    "generate:api": "openapi-generator-cli generate -g typescript-angular -i ../backend/src/main/openapi/quiver-api.yaml -o ./src/app/core/api-generated --additional-properties=supportsES6=true,providedInRoot=true",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "postcss": "^8.5.33",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "daisyui": "^5.8.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
